# ---- required ----
# Crawling. Needs no scopes (public repos). 5000 req/h vs 60 unauthenticated.
GITHUB_TOKEN=
# Redis URL. Omit to use local redis://127.0.0.1:6379.
REDIS_URL=
# Enrichment (cards) and deep-dive answers. Claude.
ANTHROPIC_API_KEY=
# Embeddings and voice. OpenAI.
OPENAI_API_KEY=

# ---- production ----
# HMAC key for the anonymous session cookie. Any long random string (openssl rand -hex 32). Without it a fixed
# dev key is used and production logs a warning once — and anyone with the repo can forge a cookie.
# Changing it signs everyone out (they get a fresh anonymous profile).
SESSION_SECRET=

# ---- optional ----
# Embedding fallback when OpenAI is unavailable.
VOYAGE_API_KEY=
# Model overrides. Defaults: claude-haiku-4-5-20251001 / same / gpt-realtime-2.1 / marin / gpt-4o-mini-transcribe.
CANDY_MODEL=
CANDY_ASK_MODEL=
REALTIME_MODEL=
REALTIME_VOICE=
REALTIME_TRANSCRIBE=
# Ceilings on what the request path may spend on models per UTC day, in dollars: global, per user, per IP.
# Defaults 25 / 3 / 8. Spend checks fail closed if Redis is unreachable.
CANDY_DAILY_USD=
CANDY_DAILY_USD_UID=
CANDY_DAILY_USD_IP=
# Unlocks spend and queue metrics on /api/health when sent as the x-candy-admin header. Without it health returns status only.
CANDY_ADMIN_TOKEN=
# Slack/Discord-style webhook that takes { text }. Paged (≤1/hour per kind) on: spend cap hit, an error
# fingerprint crossing 25/day. Unset → console only.
CANDY_ALERT_WEBHOOK=
