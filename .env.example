# Required for real crawls: 5000 req/h vs 60 unauthenticated. Needs no scopes (public repos).
GITHUB_TOKEN=
# Redis Cloud URL. Omit to use local redis://127.0.0.1:6379.
REDIS_URL=

# --- operations (all optional) ---
# HMAC key for the anonymous session cookie. Any long random string. Without it a fixed dev key is used
# and production logs a warning once. Changing it signs everyone out (they get a fresh anonymous profile).
SESSION_SECRET=
# Ceiling on what the request path may spend on models per UTC day, in dollars. Default 25.
CANDY_DAILY_USD=
# Slack/Discord-style webhook that takes { text }. Paged (≤1/hour per kind) on: spend cap hit, an error
# fingerprint crossing 25/day. Unset → console only.
CANDY_ALERT_WEBHOOK=
