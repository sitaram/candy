{
  "name": "candy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "discover": "node --env-file-if-exists=.env.local --import tsx scripts/discover.mts",
    "crawl": "node --env-file-if-exists=.env.local --import tsx scripts/crawl.mts",
    "stats": "node --env-file-if-exists=.env.local --import tsx scripts/stats.mts",
    "enrich": "node --env-file-if-exists=.env.local --import tsx scripts/enrich.mts",
    "snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot.mts",
    "pipeline": "node --env-file-if-exists=.env.local --import tsx scripts/pipeline.mts",
    "enrich:sample": "node --env-file-if-exists=.env.local --import tsx scripts/enrich-sample.mts",
    "niche": "node --env-file-if-exists=.env.local --import tsx scripts/niche.mts",
    "compact": "node --env-file-if-exists=.env.local --import tsx scripts/compact.mts",
    "embed": "node --env-file-if-exists=.env.local --import tsx scripts/embed.mts",
    "relate": "node --env-file-if-exists=.env.local --import tsx scripts/relate.mts",
    "alts": "node --env-file-if-exists=.env.local --import tsx scripts/alts.mts",
    "voice:trace": "node --env-file-if-exists=.env.local --import tsx scripts/voice-trace.mts",
    "test": "scripts/test-redis.sh && vitest run",
    "test:watch": "scripts/test-redis.sh && vitest",
    "test:cov": "scripts/test-redis.sh && vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "ioredis": "^6.0.0",
    "next": "^15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
